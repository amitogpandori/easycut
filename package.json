{
  "name": "easycut",
  "productName": "EasyCut",
  "version": "1.14.0",
  "description": "EasyCut - an easy video editor for vloggers",
  "main": "main.js",
  "author": "Amitoj",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.js && node tests/photo-reels.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.amitoj.easycut",
    "productName": "EasyCut",
    "copyright": "Copyright \u00a9 2026 Amitoj",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "upscale.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "EasyCut-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyCut",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
